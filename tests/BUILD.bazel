load(":abi_mode_test.bzl", "abi_mode_test_suite")
load(":cc_rule_test.bzl", "cc_rule_test_suite")
load(":common_test.bzl", "common_test_suite")
load(":compile_metadata_test.bzl", "compile_metadata_test_suite")
load(":format_test.bzl", "format_test_suite")
load(":java_rule_test.bzl", "java_rule_test_suite")
load(":jvm_tools_test.bzl", "jvm_tools_test_suite")
load(":kotlin_rule_test.bzl", "kotlin_rule_test_suite")
load(":native_image_test.bzl", "native_image_test_suite")
load(":python_toolchain_test.bzl", "python_toolchain_test_suite")
load(":toolchain_test.bzl", "elide_toolchain_test_suite")
load(":versions_test.bzl", "versions_test_suite")

abi_mode_test_suite(name = "abi_mode_tests")

common_test_suite(name = "common_tests")

elide_toolchain_test_suite(name = "toolchain_tests")

versions_test_suite(name = "versions_tests")

java_rule_test_suite(name = "java_rule_tests")

kotlin_rule_test_suite(name = "kotlin_rule_tests")

native_image_test_suite(name = "native_image_tests")

format_test_suite(name = "format_tests")

# Test-only toolchain registered from MODULE.bazel for analysistest resolution.
write_file(
    name = "_test_stub_src",
    out = "_test_stub_elide.sh",
    content = [
        "#!/bin/sh",
        "exit 0",
        "",
    ],
    is_executable = True,
)

native_binary(
    name = "_test_stub_elide",
    src = ":_test_stub_src",
    out = "_test_stub_elide_bin",
)

write_file(
    name = "_test_kotlin_stdlib",
    out = "stub/kotlin-stdlib.jar",
    content = ["Analysis-only Kotlin stdlib fixture"],
)

write_file(
    name = "_test_stub_clang_src",
    out = "_test_stub_clang",
    content = [
        "#!/bin/sh",
        "exit 0",
        "",
    ],
    is_executable = True,
)

write_file(
    name = "_test_cc_sysroot",
    out = "_test_cc_sysroot.txt",
    content = ["Analysis-only C sysroot fixture"],
)

elide_toolchain(
    name = "_test_elide_impl",
    binary = ":_test_stub_elide",
    cc_compiler = [":_test_stub_clang_src"],
    cc_tool_files = [":_test_cc_sysroot"],
    kotlin_stdlib = [":_test_kotlin_stdlib"],
    version = "0.0.0-test",
)

toolchain(
    name = "_test_elide_toolchain",
    toolchain = ":_test_elide_impl",
    toolchain_type = "//elide:toolchain_type",
)

# Not registered: selected only through extra_toolchains by C error tests.
elide_toolchain(
    name = "_test_elide_no_cc_impl",
    binary = ":_test_stub_elide",
    version = "0.0.0-test",
)

toolchain(
    name = "_test_elide_no_cc_toolchain",
    toolchain = ":_test_elide_no_cc_impl",
    toolchain_type = "//elide:toolchain_type",
)

cc_rule_test_suite(name = "cc_rule_tests")

jvm_tools_test_suite(name = "jvm_tools_tests")

compile_metadata_test_suite(name = "compile_metadata_tests")

python_toolchain_test_suite(name = "python_toolchain_tests")
