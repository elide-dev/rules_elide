load("@rules_elide//elide/java:toolchain.bzl", "elide_java_toolchain")
load("@rules_java//java:defs.bzl", "java_binary", "java_library", "java_plugin")

# java_library/java_binary compile through rules_elide's JavaBuilder shim. This toolchain has no Error Prone
# javacopts, so plain compiles take the `elide javac` route; `log_routes` prefixes each action's output with
# the route taken.
[config_setting(
    name = "exec_" + platform,
    constraint_values = constraints,
) for platform, constraints in {
    "linux_amd64": [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
    "linux_arm64": [
        "@platforms//os:linux",
        "@platforms//cpu:aarch64",
    ],
    "macos_arm64": [
        "@platforms//os:macos",
        "@platforms//cpu:aarch64",
    ],
}.items()]

elide_java_toolchain(
    name = "elide_java",
    elide = select({
        ":exec_linux_amd64": "@elide_linux_amd64//:elide",
        ":exec_linux_arm64": "@elide_linux_arm64//:elide",
        ":exec_macos_arm64": "@elide_macos_arm64//:elide",
    }),
    log_routes = True,
    # rules_java's default javacopts without the Error Prone ones (`-Xep…`), which need Elide's javacPlugins.
    misc = [
        "-XDskipDuplicateBridges=true",
        "-g",
        "-parameters",
    ],
)

java_library(
    name = "greeter",
    srcs = ["src/greeter/Greeter.java"],
)

java_library(
    name = "greet",
    srcs = ["src/greet/Greet.java"],
)

java_library(
    name = "greeting_processor",
    srcs = ["src/processor/GreetingProcessor.java"],
)

# Runs through `elide javac` (Elide reports javaAnnotationProcessing); its generated source jar is the
# --generated_sources_output JavaBuilder must produce.
java_plugin(
    name = "greeting",
    processor_class = "processor.GreetingProcessor",
    deps = [":greeting_processor"],
)

java_library(
    name = "app_lib",
    srcs = ["src/app/App.java"],
    javacopts = ["--release", "17"],
    plugins = [":greeting"],
    deps = [
        ":greet",
        ":greeter",
    ],
)

java_library(
    name = "stability",
    srcs = ["src/stability/Stable.java"],
)

java_library(
    name = "labeled",
    srcs = ["src/labeled/Labeled.java"],
    deps = [":stability"],
)

# Strict deps: `:stability` is on the classpath only as an indirect dependency, and the compiler loads it for
# Labeled's annotation. JavaBuilder accepts that; so must the shim.
java_library(
    name = "labeled_user",
    srcs = ["src/labeleduser/LabeledUser.java"],
    deps = [":labeled"],
)

# A source jar with no Java sources, as rules_kotlin passes for Kotlin-only source jars. JavaBuilder writes an
# empty jar for it; so must the shim.
genrule(
    name = "kotlin_only_srcjar",
    outs = ["kotlin_only.srcjar"],
    cmd = "echo 'package k' > $(@D)/K.kt && $(location @bazel_tools//tools/zip:zipper) c $@ k/K.kt=$(@D)/K.kt",
    tools = ["@bazel_tools//tools/zip:zipper"],
)

java_library(
    name = "kotlin_only",
    srcs = [":kotlin_only_srcjar"],
)

java_binary(
    name = "app",
    main_class = "app.App",
    runtime_deps = [
        ":app_lib",
        ":kotlin_only",
        ":labeled_user",
    ],
)
