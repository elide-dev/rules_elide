module(name = "rules_elide_java_builder_e2e")

bazel_dep(name = "rules_elide", version = "0.0.0")
local_path_override(
    module_name = "rules_elide",
    path = "../..",
)

bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "rules_java", version = "9.9.0")

elide = use_extension("@rules_elide//elide:extensions.bzl", "elide")
elide.install(channel = "nightly")
use_repo(elide, "elide_linux_amd64", "elide_linux_arm64", "elide_macos_arm64", "elide_toolchains")

register_toolchains("@elide_toolchains//:all")

# The Elide JavaBuilder toolchain ahead of rules_java's stock toolchains.
register_toolchains("//:elide_java_definition", "//:elide_java_default_definition")
