module(name = "rules_elide_python_overlay")

bazel_dep(name = "rules_elide", version = "0.0.0")
local_path_override(
    module_name = "rules_elide",
    path = "../..",
)

elide = use_extension("@rules_elide//elide:extensions.bzl", "elide")
elide.install(
    python = True,
    version = "1.6.3",
)
use_repo(elide, "elide_linux_amd64", "elide_toolchains")

register_toolchains("@elide_toolchains//:all")

bazel_dep(name = "rules_python", version = "1.9.2")

register_toolchains("//:elide_py")

bazel_dep(name = "platforms", version = "1.1.0")
