load("@rules_elide//elide:defs.bzl", "elide_cc_binary")

# Built with Elide's bundled clang/lld/glibc sysroot; no host C toolchain.
elide_cc_binary(
    name = "hello",
    srcs = [
        "main.c",
        "util/greet.c",
    ],
    hdrs = ["util/greet.h"],
    copts = [
        "-O2",
        "-Wall",
        "-Werror",
    ],
    defines = ["GREETING=\"elide cc\""],
    linkopts = ["-lm"],
)
