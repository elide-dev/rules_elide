load(
    "@rules_elide//elide:defs.bzl",
    "elide_java_library",
    "elide_java_test",
    "elide_kotlin_binary",
    "elide_kotlin_library",
    "elide_kotlin_test",
)
load("@rules_elide//elide/kotlin:toolchain.bzl", "register_elide_kotlin_toolchain")
load("@rules_kotlin//kotlin:jvm.bzl", "kt_jvm_library")

package(default_visibility = ["//visibility:public"])

# Minimal cross-language graph, exercised end-to-end on BuildBuddy RBE:
#   lib (Java)  <-  kt_lib (Kotlin, depends on Java)  <-  kt_app (Kotlin binary)
#   lib (Java)  <-  HelloTest (JUnit test action)
# This proves both compile and test actions run remotely through the Elide
# toolchain across the Java/Kotlin boundary.

# Compile Java to bytecode level 11 (class file version 55). Under remote
# execution the JUnit test runs via `elide java`, which on the public RBE image
# (rbe-ubuntu24-04) falls back to the image's system JDK. Elide's
# javac otherwise defaults to JDK 25 bytecode (class 69), which that runtime
# an older runtime can't load (UnsupportedClassVersionError); 11 runs anywhere.
_JAVA11 = [
    "--release",
    "11",
]

elide_java_library(
    name = "lib",
    srcs = ["sample/Hello.java"],
    javac_opts = _JAVA11,
)

elide_kotlin_library(
    name = "kt_lib",
    srcs = ["sample/Greeter.kt"],
    module_name = "greeter",
    deps = [":lib"],  # cross-language: Kotlin -> Java
)

elide_kotlin_binary(
    name = "kt_app",
    srcs = ["sample/App.kt"],
    main_class = "sample.AppKt",
    deps = [":kt_lib"],
)

elide_java_test(
    name = "HelloTest",
    srcs = ["sample/HelloTest.java"],
    javac_opts = _JAVA11,
    test_class = "sample.HelloTest",
    runtime_deps = ["@maven//:org_junit_platform_junit_platform_console_standalone"],
    deps = [
        ":lib",
        "@maven//:org_junit_jupiter_junit_jupiter_api",
    ],
)

elide_kotlin_test(
    name = "KotlinTest",
    srcs = ["sample/KotlinTest.kt"],
    test_class = "sample.KotlinTest",
    runtime_deps = ["@maven//:org_junit_platform_junit_platform_console_standalone"],
    deps = [
        ":kt_lib",
        "@maven//:org_junit_jupiter_junit_jupiter_api",
    ],
)

# rules_kotlin's kt_jvm_library compiled through the Elide KotlinBuilder shim.
# The shim runs on `elide java`, which needs the distribution's lib/ and conf/
# on the executor: `@elide_<os>_<cpu>//:elide` carries them as runfiles, while
# the bare `:bin/elide` file would fail with "Error loading java.security file".
[config_setting(
    name = "exec_" + platform,
    constraint_values = constraints,
) for platform, constraints in {
    "linux_amd64": [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
    "linux_arm64": [
        "@platforms//os:linux",
        "@platforms//cpu:aarch64",
    ],
    "macos_arm64": [
        "@platforms//os:macos",
        "@platforms//cpu:aarch64",
    ],
}.items()]

register_elide_kotlin_toolchain(
    name = "elide_kt",
    api_version = "2.4",
    # The launcher is built for the execution platform, so this selects the
    # executor's distribution.
    elide = select({
        ":exec_linux_amd64": "@elide_linux_amd64//:elide",
        ":exec_linux_arm64": "@elide_linux_arm64//:elide",
        ":exec_macos_arm64": "@elide_macos_arm64//:elide",
    }),
    experimental_use_abi_jars = True,
    fallback_builder = "@rules_kotlin//src/main/kotlin:build",
    jvm_target = "21",
    language_version = "2.4",
)

kt_jvm_library(
    name = "kt_builder_lib",
    srcs = ["sample/BuilderGreeting.kt"],
)
