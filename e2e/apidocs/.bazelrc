common --enable_bzlmod
common --lockfile_mode=update
# rules_elide depends on rules_kotlin, which pulls rules_android; its SDK extension validates any
# ANDROID_HOME it finds. Empty, it stubs harmlessly.
common --repo_env=ANDROID_HOME=
build --incompatible_strict_action_env
build --sandbox_default_allow_network=false
test --test_output=errors

# elide-dev/doclet targets JDK 25 (its javadoc API includes Markdown comments). The doclet is an
# exec-configuration tool, so the tool settings compile it and run javadoc on the hermetic remote
# JDK 25; the target settings keep the fixtures on the same JDK.
build --java_language_version=25
build --tool_java_language_version=25
build --java_runtime_version=remotejdk_25
build --tool_java_runtime_version=remotejdk_25
