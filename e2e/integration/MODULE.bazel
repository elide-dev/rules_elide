module(name = "rules_elide_integration")

bazel_dep(name = "rules_elide", version = "0.0.0")
local_path_override(
    module_name = "rules_elide",
    path = "../..",
)

bazel_dep(name = "rules_java", version = "9.9.0")
bazel_dep(name = "rules_jvm_external", version = "7.2")

# Activate the module extension against a checksum-pinned release. This
# downloads the elide binary at repo-rule time, enabling real `bazel build`
# of the sample target against the actual toolchain.
elide = use_extension("@rules_elide//elide:extensions.bzl", "elide")
elide.install(version = "1.6.2")
use_repo(elide, "elide_toolchains")

register_toolchains("@elide_toolchains//:all")

# JUnit Platform deps via Maven for test rules.
maven = use_extension("@rules_jvm_external//:extensions.bzl", "maven")
maven.install(
    artifacts = [
        "org.junit.jupiter:junit-jupiter-api:5.10.2",
        "org.junit.platform:junit-platform-console-standalone:1.10.2",
    ],
)
use_repo(maven, "maven")
