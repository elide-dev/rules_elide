load("@bazel_skylib//rules:common_settings.bzl", "bool_flag")

package(default_visibility = ["//visibility:public"])

# Tunables for the elide kotlinc compile path, flippable on the command line,
# e.g. `--@rules_elide//config/kotlinc:incremental=true`.

# Opt-in (default off): incremental Kotlin compilation. A singleplex adapter
# forwards requests to a resident Elide compiler, retaining both classes and IC
# caches in worker-private scratch. It publishes a complete jar each time, so
# Bazel output deletion cannot discard unchanged classes. Worker restart or
# changed flags/non-source inputs starts fresh; one-shot execution is cold.
# javac is unaffected (no IC support upstream). Experimental.
bool_flag(
    name = "incremental",
    build_setting_default = False,
)

# Matches when `--@rules_elide//config/kotlinc:incremental=True`. Lets the Kotlin
# toolchain default resident persistent-worker forwarding on whenever incremental
# compilation is enabled (IC is only useful with a warm resident worker).
config_setting(
    name = "incremental_enabled",
    flag_values = {":incremental": "True"},
)

# Opt-in (default off): Karbine ABI compile-avoidance (WHIPLASH#1111, rules
# issue #11). When true, a Kotlin or mixed Kotlin/Java target's `JavaInfo.compile_jar` is a
# header jar produced by a dedicated `elide kotlinc --abi-only` action instead
# of the `java_common.run_ijar`-derived jar. A method-*body* edit yields a
# byte-identical header (same digest), so Bazel prunes every dependent rebuild;
# dependents also key on the fast codegen-free header action rather than the
# full compile. `const`/`inline`/signature changes still change the header, so
# pruning stays sound. Mixed kt+java headers include both Kotlin and Java ABI. Verify
# soundness with //e2e/abi_avoidance. Experimental.
bool_flag(
    name = "abi_compile_avoidance",
    build_setting_default = False,
)

# On (default): the KotlinBuilder shim emits a Bazel `[warning]` when it rewrites
# a rules_kotlin `-Xplugin=<jar>` that duplicates an Elide builtin compiler
# plugin (e.g. kotlinx-serialization) to the version-pinned `--plugins=<name>`
# builtin. Flip to False to silence the warning once the behavior is understood
# (the rewrite itself always happens). The toolchain launcher passes the shim
# `--quiet_plugin_rewrite` when this is False.
bool_flag(
    name = "warn_builtin_plugin_rewrite",
    build_setting_default = True,
)

config_setting(
    name = "warn_builtin_plugin_rewrite_disabled",
    flag_values = {":warn_builtin_plugin_rewrite": "False"},
)

# Experimental: emit the ABI alongside full compilation, saving a compiler pass.
# Requires abi_compile_avoidance. Pure Kotlin without resources, plugins, friends,
# or incremental compilation only; other targets retain the separate header pass.
# Dependents wait for the full compile, so benchmark your graph before enabling.
bool_flag(
    name = "abi_from_compile",
    build_setting_default = False,
)
