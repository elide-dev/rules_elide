load("@bazel_skylib//rules:common_settings.bzl", "bool_flag")

package(default_visibility = ["//visibility:public"])

# Tunables for the elide javac compile path, flippable on the command line,
# e.g. `--@rules_elide//config/javac:classpath_cache=true`.

# Opt-in (default off, matching upstream's correctness-first stance): pass
# `--classpath-cache` so a persistent `elide javac` worker reuses parsed
# classpath state across warm compiles, keyed by input digests — unchanged
# dependency jars are not re-indexed on every request. Worker-only (no effect
# without persistent workers); honored for every request as a constant-per-worker
# setting, so it participates in the Bazel worker key. Processor-free targets
# also receive -proc:none, which upstream requires for reuse. Declared plugins
# and explicit processor options are preserved and may make requests ineligible.
# Classpath-only processor discovery is disabled by this opt-in; declare processors
# explicitly when needed. Empty classpaths and missing digests bypass the cache.
bool_flag(
    name = "classpath_cache",
    build_setting_default = False,
)

# Matches when `--@rules_elide//config/javac:classpath_cache=True`.
config_setting(
    name = "classpath_cache_enabled",
    flag_values = {":classpath_cache": "True"},
)

# Opt-in source header compilation via Elide javac --abi-only. Dependents
# compile against the header while runtime consumers retain the full jar.
# Annotation processors and resource_jars fall back to the full-compile ijar.
bool_flag(
    name = "abi_compile_avoidance",
    build_setting_default = False,
)

# Experimental: emit the ABI alongside full compilation, saving a compiler action.
# Requires abi_compile_avoidance. Processor/plugin and resource_jar configurations
# retain their full-compile ijar fallback. Consumers wait for the full compile.
bool_flag(
    name = "abi_from_compile",
    build_setting_default = False,
)
